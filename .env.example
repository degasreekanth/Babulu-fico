# Optional Google Apps Script web app URL (Google Sheet + email). When set it
# takes precedence over the default delivery below.
VITE_LEAD_WEBHOOK_URL=

# With no webhook or Supabase config, demo requests are emailed to
# erpwondersapfi@gmail.com through FormSubmit (formsubmit.co) directly from
# the page. The first submission triggers a one-time activation email from
# FormSubmit — click its link once and every later request is delivered.

# Optional: store enquiries in Supabase instead (or as a second copy).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
